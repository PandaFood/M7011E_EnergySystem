<div id="dashboard">

    <div id="picture-div">
            <i class="fas fa-igloo"></i>
    </div>
    <div id="data-div">
        Production: <span id="data-production">10 kWh</span></br>
        Consumption:<span id="data-consumption">10 kWh</span></br>
        Net production: <span id="data-net-production">10 kWh</span></br>
        Price: <span id="data-price">50kr/kWh</span></br>
    </div>
        
    <div id="table-div">
        <div id="turbine-div">
            <h2>Wind Turbines</h2>

            <!-- Hidden template table -->
            <table id="wind-table-template" style="display:none;">
                <tr id="template-turbine-row">
                    <td> <span class="turbine-name">Name </span></td>
                    <td> <span class="turbine-speed">speed</span></td>
                    <td> <span class="turbine-production">Production</span></td>
                    <td> <span class="turbine-status">Status</span></td>
                </tr>
            </table>
            <table id="wind-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-fan"></i> Name</th>
                        <th><i class="fas fa-wind"></i> Wind Speed</th>
                        <th><i class="fas fa-bolt"></i> Production</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <div id="battery-div">

            <h2>Batteries</h2>

            <!-- Hidden template table -->
            <table id="battery-table-template" style="display:none;">
                <tr id="template-battery-row">
                    <td> <span class="battery-name">Name </span></td>
                    <td> <span class="battery-capacity">Cap</span></td>
                    <td> <span class="battery-max">Max</span></td>
                    <td> <span class="battery-fill">Fill</span></td>
                </tr>
            </table>
            <table id="battery-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-car-battery"></i> Name</th>
                        <th><i class="fas fa-battery-half"></i> Capacity</th>
                        <th><i class="fas fa-battery-full"></i> Max Capacity</th>
                        <th> Fill Goal</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript" src="//cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>

    <script src="/javascript/windturbine.js"></script>
    <script src="/javascript/battery.js"></script>

</div>